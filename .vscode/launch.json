{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Compiler",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Compiler",
      "program": "${workspaceFolder}/src/bin/Debug/net11.0/Compiler.dll",
      "args": ["${input:sourceFile}"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Lexer Concept",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Lexer Concept",
      "program": "${workspaceFolder}/obj/lexer-debug/lexer.dll",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Parser Concept",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Parser Concept",
      "program": "${workspaceFolder}/obj/parser-debug/parser.dll",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Compiler Concept",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Compiler Concept",
      "program": "${workspaceFolder}/obj/compiler-debug/compiler.dll",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "sourceFile",
      "type": "promptString",
      "description": "Path to the C source file to compile"
    }
  ]
}
